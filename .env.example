# === Server ===
PORT=3147
# Ignored under docker compose: the mend service sets DATABASE_URL to the postgres container.
DATABASE_URL=postgres://mend:mend@localhost:5434/mend
TEST_DATABASE_URL=postgres://mend_test:mend_test@localhost:5435/mend_test
PROJECTS_CONFIG=mend.yml
# Set to 1 to save every authenticated webhook payload under fixtures/webhooks/.
RECORD_WEBHOOKS=0
# Enables /evals and /improvements (HTTP Basic password or Bearer, at least 32 characters).
# Unset keeps them disabled (404). Generate one with `openssl rand -hex 32`.
# DASHBOARD_TOKEN=

# === Per-project secrets (referenced as ${VAR} in mend.yml) ===
# GitLab project access token: role Developer, scope `api` (also used for HTTPS cloning).
BACKEND_GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx
# GitLab webhook signing token (recommended), referenced by `webhook_signing_token`.
BACKEND_WEBHOOK_SIGNING_TOKEN=whsec_xxxxxxxxxxxxxxxxxxxx
# Secret token, referenced by `webhook_secret`; only needed without a signing token.
# BACKEND_WEBHOOK_SECRET=your-webhook-secret

# === Model auth (read by the harnesses, not by Mend) ===
# Subscription auth instead of keys: `codex login`, `pi` then `/login`, `opencode auth login`.
# Use `openai/<model>` (not `openai-codex/<model>`) for Pi models billed to an API key.
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# === Optional docs lookup tool ===
# CONTEXT7_API_KEY=xxxxxxxxxxxxxxxxxxxx

# === Optional Cloudflare webhook tunnel ===
# Named tunnel token to expose Mend webhook endpoint publicly
# CLOUDFLARED_MEND_TOKEN=eyJhIjoi...snip...
