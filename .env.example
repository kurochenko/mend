# === Server ===
PORT=3147
DATABASE_URL=postgres://mend:mend@localhost:5434/mend
TEST_DATABASE_URL=postgres://mend_test:mend_test@localhost:5435/mend_test
PROJECTS_CONFIG=mend.yml
RECORD_WEBHOOKS=0

# === Per-project secrets (referenced as ${VAR} in mend.yml) ===
BACKEND_GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx
BACKEND_WEBHOOK_SECRET=your-webhook-secret

# === Pi auth (managed by Pi, not by Mend) ===
# Pi reads API keys from env vars or ~/.pi/agent/auth.json.
# For subscription auth (Claude Max, Codex): run `pi` then `/login`.
# For API key auth: set the relevant env var below.
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# === Optional docs lookup tool ===
# CONTEXT7_API_KEY=xxxxxxxxxxxxxxxxxxxx

# === Optional Cloudflare webhook tunnel ===
# Named tunnel token to expose Mend webhook endpoint publicly
# CLOUDFLARED_MEND_TOKEN=eyJhIjoi...snip...
