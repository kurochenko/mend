{
  "name": "mend",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Autonomous agentic system for bug fixing and MR review",
  "type": "module",
  "scripts": {
    "prepare": "lefthook install",
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "tunnel:webhooks": "sh -lc 'cloudflared tunnel --no-autoupdate run --token \"$CLOUDFLARED_MEND_TOKEN\"'",
    "tunnel:webhooks:quick": "sh -lc 'cloudflared tunnel --no-autoupdate --url http://127.0.0.1:${PORT:-3147}'",
    "test": "bun test ./src",
    "test:e2e": "bun test ./tests/e2e/*.e2e.ts",
    "test:broad": "bun test",
    "test:coverage": "bun test ./src --coverage",
    "test:db": "bun test src/db",
    "replay": "bun run src/cli/replay.ts",
    "runs": "bun run src/cli/runs.ts",
    "improvements": "bun run src/cli/improvements.ts",
    "service-control": "bun run src/cli/service-control.ts",
    "context7-fetch": "bun run tools/context7-fetch.ts",
    "format": "biome format .",
    "format:write": "biome format --write .",
    "lint": "bun run lint:ox && bun run lint:eslint && bun run lint:knip && bun run lint:depcruise",
    "lint:ox": "oxlint src tools scripts tests",
    "lint:eslint": "eslint src tools scripts tests eslint.config.mjs drizzle.config.ts --max-warnings 69",
    "lint:knip": "knip",
    "lint:depcruise": "depcruise src tools scripts --config .dependency-cruiser.cjs",
    "check:agent": "./scripts/check-agent.sh",
    "review": "bun run scripts/review.ts",
    "check": "bun run format && bun run lint && bun run typecheck && bun run test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:test:setup": "DATABASE_URL=${TEST_DATABASE_URL:?TEST_DATABASE_URL not set} drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "bun": ">=1.3.9"
  },
  "dependencies": {
    "@mariozechner/pi-coding-agent": "0.73.1",
    "@mastra/core": "^1.7.0",
    "@mastra/hono": "^1.1.6",
    "@mastra/pg": "^1.6.1",
    "@sinclair/typebox": "^0.34.49",
    "dependency-cruiser": "18.0.0",
    "drizzle-orm": "0.45.2",
    "hono": "^4.7.4",
    "postgres": "^3.4.5",
    "yaml": "^2.8.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@eslint/js": "^10.0.1",
    "@types/bun": "1.3.14",
    "drizzle-kit": "0.31.10",
    "eslint": "^10.4.1",
    "globals": "^17.6.0",
    "knip": "^6.15.0",
    "lefthook": "^2.1.9",
    "mastra": "^1.3.4",
    "oxlint": "^1.68.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.60.1"
  }
}
